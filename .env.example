# Copy to .env (gitignored) and fill in. Read by docker-compose.yml.
# Access code the visitors type once (empty = open API).
LCP_ACCESS_CODE=
# Origins allowed to call the API from a browser (the Vercel site; localhost for development).
LCP_CORS_ORIGINS=https://lcp-web.vercel.app,http://localhost:8000,http://127.0.0.1:8000
# Texts one address may have running or waiting.
LCP_PER_IP_MAX=2
